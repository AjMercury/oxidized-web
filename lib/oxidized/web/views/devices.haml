.page-heading
  .page-heading-copy
    %span.eyebrow.text-muted Administrator workspace
    %h1 Device management
    %p Add, update, remove, and back up devices from the configured Oxidized inventory.
- required_inventory_fields = %w[name model ip].freeze
- missing_inventory_fields = @inventory_mapping_error ? @inventory_error.to_s.split(':').last.to_s.split(',').map(&:strip) : required_inventory_fields.reject { |field| @device_fields.include?(field) }
- missing_inventory_fields = [] if @inventory_error && !@inventory_mapping_error
- mapping_incomplete = @inventory_mapping_error || (@inventory_error.nil? && missing_inventory_fields.any?)

- if params[:notice]
  .alert.alert-success{role: 'status'} Device #{params[:notice]} successfully.
- if @inventory_error || mapping_incomplete
  .alert.alert-warning.inventory-source-alert{role: 'status'}
    %strong Inventory mutations are disabled
    - if @inventory_error
      %p.mb-1= @inventory_error
    - if mapping_incomplete
      %p.mb-1 Missing required Oxidized fields: #{missing_inventory_fields.join(', ')}. Configure these mappings against the actual CSV header and column order.
      %details
        %summary Show the required CSV mapping keys
        %pre.mt-2.mb-1
          %code= "source:\n  csv:\n    map:\n      name: <zero-based column index>\n      model: <zero-based column index>\n      ip: <zero-based column index>"
        %small Use the zero-based positions from your existing CSV. Do not copy placeholder values as literal settings.
    %small Inventory data was not changed.

.section-heading
  .section-heading-copy
    %h2= @current_admin == :viewer ? 'Inventory access' : 'Add device'
    %p= @current_admin == :viewer ? 'Your account has read-only access to the configured Oxidized inventory.' : 'Credentials are written only to the configured CSV source and are never returned by the management API.'
- if @current_admin != :viewer && @inventory_error.nil? && !mapping_incomplete
  .table-card.device-form-card
    %form{action: url_for('/admin/devices'), method: 'post', autocomplete: 'off', :'data-loading-label' => 'Adding device…'}
      %input{type: 'hidden', name: 'csrf_token', value: @csrf_token}
      .device-form-grid
        - [['name', 'Hostname', 'router-01.example.net'], ['ip', 'Management IP / FQDN', '192.0.2.10'], ['group', 'Device group', 'branch'], ['username', 'Username', 'oxidized']].each do |field, label, placeholder|
          - if @device_fields.include?(field)
            .mb-3
              %label.form-label{for: "device-#{field}"}
                = label
                - if %w[name ip].include?(field)
                  %span.required-indicator{:'aria-hidden' => 'true'} *
                  %span.visually-hidden required
              %input.form-control{id: "device-#{field}", name: field, type: 'text', placeholder: placeholder, required: %w[name ip].include?(field), autocomplete: 'off'}
        - if @device_fields.include?('model')
          .mb-3
            %label.form-label{for: 'device-vendor'} Vendor
            %select.form-select#device-vendor{:'aria-label' => 'Filter models by vendor'}
              %option{value: ''} All vendors
              - @models.map { |model| vendor_for_model(model) }.uniq.sort.each do |vendor|
                %option{value: vendor, :'data-logo-url' => vendor_logo_asset(vendor) && url_for("/images/vendors/#{vendor_logo_asset(vendor)}.svg")}= vendor
            .vendor-selector-brand#vendorLogoPreview{:'aria-live' => 'polite'}
              %i.bi.bi-hdd-network{:'aria-hidden' => 'true'}
              %span Select a vendor to preview its logo
          .mb-3
            %label.form-label.mt-2{for: 'device-model'}
              Oxidized model
              %span.required-indicator{:'aria-hidden' => 'true'} *
              %span.visually-hidden required
            %input.form-control#device-model{name: 'model', type: 'search', list: 'oxidized-model-list', placeholder: 'Search installed Core models…', required: true, autocomplete: 'off'}
            %datalist#oxidized-model-list
              - @models.each do |model|
                %option{value: model, :'data-vendor' => vendor_for_model(model)}
        - [['password', 'Password'], ['enable', 'Enable password'], ['ssh_port', 'SSH port'], ['telnet_port', 'Telnet port'], ['timeout', 'Connection timeout'], ['input', 'Connection protocol'], ['description', 'Description']].each do |field, label|
          - if @device_fields.include?(field)
            .mb-3
              %label.form-label{for: "device-#{field}"}= label
              %input.form-control{id: "device-#{field}", name: field, type: %w[password enable].include?(field) ? 'password' : 'text', autocomplete: %w[password enable].include?(field) ? 'new-password' : 'off'}
      .device-form-actions
        %button.btn.btn-primary{type: 'submit', disabled: !%w[name model ip].all? { |field| @device_fields.include?(field) }}
          %i.bi.bi-plus-lg{:'aria-hidden' => 'true'}
          Add device

.section-heading
  .section-heading-copy
    %h2 Managed devices
    %p Device state and backup results come from the live Oxidized node inventory.
  .page-heading-actions
    != haml :backup_all, layout: false
    %a.btn.btn-outline-secondary{href: url_for('/admin/devices/export.csv')}
      %i.bi.bi-download{:'aria-hidden' => 'true'}
      Export inventory
.table-card
  .table-toolbar
    .table-search
      %i.bi.bi-search{:'aria-hidden' => 'true'}
      %label.visually-hidden{for: 'managedSearch'} Search managed devices
      %input#managedSearch{type: 'search', placeholder: 'Search name, address, model, or group…'}
    %label.visually-hidden{for: 'managedVendorFilter'} Filter devices by vendor
    %select.form-select.form-select-sm#managedVendorFilter{style: 'max-width: 170px'}
      %option{value: ''} All vendors
      - @data.map { |node| vendor_for_model(node[:model]) }.uniq.sort.each do |vendor|
        %option{value: vendor}= vendor
    %label.visually-hidden{for: 'managedModelFilter'} Filter devices by model
    %select.form-select.form-select-sm#managedModelFilter{style: 'max-width: 170px'}
      %option{value: ''} All models
      - @data.map { |node| node[:model].to_s }.uniq.sort.each do |model|
        %option{value: model}= model
    %label.visually-hidden{for: 'managedGroupFilter'} Filter devices by group
    %select.form-select.form-select-sm#managedGroupFilter{style: 'max-width: 170px'}
      %option{value: ''} All groups
      - @data.map { |node| node[:group].to_s }.uniq.sort.each do |group|
        %option{value: group}= group
    %label.visually-hidden{for: 'managedStatusFilter'} Filter devices by backup status
    %select.form-select.form-select-sm#managedStatusFilter{style: 'max-width: 180px'}
      %option{value: ''} All backup statuses
      - @data.map { |node| node[:backup_state].to_s.tr('_', ' ') }.uniq.sort.each do |state|
        %option{value: state}= state
    %button.btn.btn-outline-secondary.btn-sm#managedReset{type: 'button'}
      %i.bi.bi-eraser{:'aria-hidden' => 'true'}
      Clear filters
    - if @current_admin != :viewer
      %form#bulkDevices{action: url_for('/admin/devices/bulk'), method: 'post', onsubmit: "var op = document.getElementById('bulkOperation').value; return op === 'delete' ? confirm('Delete all selected devices from the configured inventory?') : (op === 'backup' ? confirm('Queue backups for all selected devices?') : true)"}
        %input{type: 'hidden', name: 'csrf_token', value: @csrf_token}
        %label.visually-hidden{for: 'bulkOperation'} Bulk operation
        %select.form-select.form-select-sm#bulkOperation{name: 'operation', style: 'max-width: 190px'}
          %option{value: 'backup'} Queue backups
          %option{value: 'export'} Export selected (no credentials)
          - if @group_assignable
            %option{value: 'group'} Assign group
          %option{value: 'delete'} Delete selected
        - if @group_assignable
          %label.visually-hidden{for: 'bulkGroup'} New group
          %input.form-control.form-control-sm#bulkGroup{name: 'group', type: 'text', placeholder: 'Group', style: 'max-width: 180px'}
        %button.btn.btn-outline-primary.btn-sm{type: 'submit'} Apply to selected
  .table-responsive
    %table.table.table-hover.align-middle#managedDevices{:'data-first-inventory-column' => @current_admin == :viewer ? 0 : 1}
      %thead
        %tr
          - if @current_admin != :viewer
            %th
              %input#selectAllDevices{type: 'checkbox', :'aria-label' => 'Select all devices'}
          %th Device
          %th Address
          %th Vendor
          %th Model
          %th Group
          %th Status
          %th Last backup
          %th Actions
      %tbody
        - @data.sort_by { |node| node[:name].to_s.downcase }.each do |node|
          %tr
            - if @current_admin != :viewer
              %td
                %input.device-selection{type: 'checkbox', name: 'devices[]', value: node[:name], form: 'bulkDevices', :'aria-label' => "Select #{node[:name]}"}
            %td.device-cell
              %a.device-name{href: url_for("/node/show/#{node[:name]}")}= node[:name]
            %td.text-muted= node[:ip]
            %td.vendor-cell
              %span.vendor-mark{class: "vendor-#{vendor_logo(node[:model])}", title: vendor_for_model(node[:model])}
                - if vendor_logo_asset(node[:model])
                  %img.vendor-logo{src: url_for("/images/vendors/#{vendor_logo_asset(node[:model])}.svg"), alt: '', loading: 'lazy'}
                - else
                  %i.bi.bi-hdd-network{:'aria-hidden' => 'true'}
              = vendor_for_model(node[:model])
            %td= node[:model]
            %td= node[:group]
            %td
              %span.status-pill{class: "status-#{node[:backup_state]}"}= node[:backup_state].to_s.tr('_', ' ')
            %td.time.text-nowrap{epoch: node[:last_attempt_at] && node[:last_attempt_at].to_time.to_i}= node[:last_attempt_at] || 'Not checked this session'
            %td.actions-cell
              - if @current_admin != :viewer
                %a.action-link{title: 'Edit device', :'aria-label' => "Edit #{node[:name]}", href: url_for("/admin/devices/#{node[:name]}/edit")}
                  %i.bi.bi-pencil-square{:'aria-hidden' => 'true'}
                %form.inline-action{action: url_for("/node/next/#{node[:full_name]}"), method: 'post'}
                  %input{type: 'hidden', name: 'csrf_token', value: @csrf_token}
                  %button.action-link{title: 'Run configuration backup', :'aria-label' => "Run backup for #{node[:name]}", type: 'submit'}
                    %i.bi.bi-cloud-arrow-down{:'aria-hidden' => 'true'}
                    Backup Now
                %form.inline-action{action: url_for("/admin/devices/#{node[:name]}/delete"), method: 'post', onsubmit: "return confirm('Delete this device from the configured inventory?')"}
                  %input{type: 'hidden', name: 'csrf_token', value: @csrf_token}
                  %button.action-link.text-danger{title: 'Delete device', :'aria-label' => "Delete #{node[:name]}", type: 'submit'}
                    %i.bi.bi-trash{:'aria-hidden' => 'true'}
        - if @data.empty?
          %tr
            %td.empty-state{colspan: @current_admin == :viewer ? 8 : 9} No devices are currently loaded from the configured inventory.

:javascript
  $(function() {
    var models = Array.from(document.querySelectorAll('#oxidized-model-list option'));
    $('#device-vendor').on('change', function() {
      var vendor = this.value;
      var selected = this.options[this.selectedIndex];
      var logoUrl = selected && selected.dataset.logoUrl;
      var preview = document.getElementById('vendorLogoPreview');
      if (preview) {
        preview.replaceChildren();
        if (logoUrl) {
          var image = document.createElement('img');
          image.className = 'vendor-logo';
          image.alt = '';
          image.src = logoUrl;
          preview.appendChild(image);
        } else {
          var fallback = document.createElement('i');
          fallback.className = 'bi bi-hdd-network';
          fallback.setAttribute('aria-hidden', 'true');
          preview.appendChild(fallback);
        }
        var label = document.createElement('span');
        label.textContent = vendor || 'Select a vendor to preview its logo';
        preview.appendChild(label);
      }
      models.forEach(function(option) { option.disabled = !!vendor && option.dataset.vendor !== vendor; });
      var current = document.getElementById('device-model');
      if (vendor && current.value && !models.some(function(option) { return option.value === current.value && option.dataset.vendor === vendor; })) current.value = '';
    });
    var firstInventoryColumn = Number(document.getElementById('managedDevices').dataset.firstInventoryColumn || 0);
    var disabledColumns = [document.querySelectorAll('#managedDevices thead th').length - 1];
    if (document.querySelector('.device-selection')) disabledColumns.push(0);
    var managed = $('#managedDevices').DataTable({
      autoWidth: false,
      order: [[firstInventoryColumn, 'asc']],
      columnDefs: [{ targets: disabledColumns, orderable: false, searchable: false }],
      stateSave: true,
      dom: 'lrtip',
      searching: true
    });
    $('#managedVendorFilter').on('change', function() { managed.column(firstInventoryColumn + 2).search(this.value, false, false).draw(); });
    $('#managedModelFilter').on('change', function() { managed.column(firstInventoryColumn + 3).search(this.value, false, false).draw(); });
    $('#managedGroupFilter').on('change', function() { managed.column(firstInventoryColumn + 4).search(this.value, false, false).draw(); });
    $('#managedStatusFilter').on('change', function() { managed.column(firstInventoryColumn + 5).search(this.value, false, false).draw(); });
    $('#managedSearch').on('input', function() { managed.search(this.value).draw(); });
    $('#managedReset').on('click', function() {
      $('#managedSearch').val('');
      $('#managedVendorFilter, #managedModelFilter, #managedGroupFilter, #managedStatusFilter').val('');
      managed.search('');
      managed.columns().every(function() { this.search(''); });
      managed.draw();
    });
    $('#selectAllDevices').on('change', function() {
      $('.device-selection').prop('checked', this.checked);
    });
    $('.device-selection').on('change', function() {
      $('#selectAllDevices').prop('checked', $('.device-selection:not(:checked)').length === 0);
    });
  });
