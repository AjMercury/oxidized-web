- history_url = url_for("/node/version?#{Rack::Utils.build_query(node_full: @device_full_name)}")
.page-heading
  .page-heading-copy
    .breadcrumbs
      %a{href: url_for('/nodes')} Devices
      %i.bi.bi-chevron-right{:'aria-hidden' => 'true'}
      %span= @data[:name]
    %span.eyebrow.text-muted Device details
    %h1= @data[:name]
    %p
      %span.vendor-mark{class: "vendor-#{vendor_logo(@data[:model])}", title: vendor_for_model(@data[:model])}
        - if vendor_logo_asset(@data[:model])
          %img.vendor-logo{src: url_for("/images/vendors/#{vendor_logo_asset(@data[:model])}.svg"), alt: '', loading: 'lazy'}
        - else
          %i.bi.bi-hdd-network{:'aria-hidden' => 'true'}
      #{@data[:ip] || 'Unknown address'} · #{vendor_for_model(@data[:model])} · #{@data[:model]}
      %span.status-pill{class: "status-#{@device_status || 'unknown'}"}= (@device_status || 'unknown').to_s.tr('_', ' ')
  .page-heading-actions
    %a.btn.btn-outline-secondary{href: history_url}
      %i.bi.bi-clock-history{:'aria-hidden' => 'true'}
      Version history
    %a.btn.btn-outline-secondary{href: url_for("/node/configuration?#{Rack::Utils.build_query(node_full: @device_full_name)}")}
      %i.bi.bi-file-earmark-code{:'aria-hidden' => 'true'}
      View configuration
    - if @current_admin == :admin
      %form.inline-action{action: url_for("/node/next/#{@device_full_name}"), method: 'post'}
        %input{type: 'hidden', name: 'csrf_token', value: @csrf_token}
        %button.btn.btn-primary{type: 'submit'}
          %i.bi.bi-arrow-repeat{:'aria-hidden' => 'true'}
          Backup now
    - if @management_error.nil?
      %a.btn.btn-outline-primary{href: url_for("/admin/devices/#{@data[:name]}/edit")}
        %i.bi.bi-pencil-square{:'aria-hidden' => 'true'}
        Edit device
    - else
      %a.btn.btn-outline-secondary{href: url_for('/admin/devices'), title: @management_error}
        %i.bi.bi-shield-lock{:'aria-hidden' => 'true'}
        Admin actions unavailable

.device-detail-grid
  .detail-card.detail-card-vendor
    %span.detail-label Device identity
    %strong= @data[:name]
    %span.detail-value Management address: #{@data[:ip] || 'Unknown'}
    %span.detail-value Vendor / model: #{vendor_for_model(@data[:model])} · #{@data[:model]}
    %span.detail-value Group: #{@data[:group] || 'default'}
  .detail-card.detail-card-version
    %span.detail-label Software information
    %strong= software_version_for(@data)
    %span.detail-value Detected from saved configuration when available; this page does not probe the device.
    - if @data[:platform]
      %span.detail-value Platform: #{@data[:platform]}
  .detail-card.detail-card-status
    %span.detail-label Latest backup attempt
    %strong.status-pill{class: "status-#{@device_status || 'unknown'}"}= (@device_status || 'unknown').to_s.tr('_', ' ')
    %span.detail-value.time{epoch: @device_time.respond_to?(:to_i) ? @device_time.to_i : ''}= @device_time
    %span.detail-value.status-failure-reason= @device_failure_reason if @device_failure_reason
  .detail-card.detail-card-revisions
    %span.detail-label Configuration history
    %strong= @device_revision_count.nil? ? 'Unknown' : @device_revision_count
    %span.detail-value Saved revisions
    %span.detail-value Last stored revision: #{@device_last_stored_at}
    %span.detail-value Last detected change: #{@device_mtime}

- metadata = (@data[:vars] || {}).select { |_key, value| !value.nil? && !value.is_a?(Hash) && !value.is_a?(Array) }.to_a
.section-heading
  .section-heading-copy
    %h2 Device metadata
    %p Readable fields from Oxidized node data. Sensitive values are redacted before rendering.
.metadata-card
  - if metadata.empty?
    .empty-state No additional device metadata is available.
  - else
    .metadata-grid
      - metadata.each do |key, value|
        .metadata-field
          %span.metadata-label= key.to_s.split('_').map(&:capitalize).join(' ')
          %strong= value.to_s == '<hidden>' ? 'Protected by redaction policy' : value
%details.advanced-details
  %summary Advanced technical details
  .config-panel.advanced-json-panel
    .config-panel-header
      .config-panel-label
        %i.bi.bi-braces{:'aria-hidden' => 'true'}
        Redacted Oxidized node data
      %button.btn.btn-outline-secondary.btn-sm{type: 'button', :'data-copy-target' => 'deviceMetadataJson'}
        %i.bi.bi-clipboard{:'aria-hidden' => 'true'}
        Copy JSON
    %pre.config-view#deviceMetadataJson{role: 'region', :'aria-label' => 'Advanced redacted device metadata', tabindex: '0'}
      %code= JSON.pretty_generate(@data)
:javascript
  document.querySelectorAll('[data-copy-target]').forEach(function(button) {
    button.addEventListener('click', function() {
      var target = document.getElementById(button.dataset.copyTarget);
      if (!target) return;
      var copied = function() {
        button.setAttribute('aria-label', 'JSON copied');
        button.textContent = 'Copied';
      };
      var unavailable = function() { button.textContent = 'Copy unavailable'; };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(target.textContent).then(copied).catch(unavailable);
      } else {
        var temporary = document.createElement('textarea');
        temporary.value = target.textContent;
        document.body.appendChild(temporary);
        temporary.select();
        var wasCopied = document.execCommand('copy');
        temporary.remove();
        wasCopied ? copied() : unavailable();
      }
    });
  });
