- total_nodes = @data.length
- successful_nodes = @data.count { |node| node[:status].to_s == 'success' }
- failed_nodes = @data.count { |node| node[:status].to_s == 'no_connection' }
- nodes_without_history = @data.count { |node| node[:status].to_s == 'never' }
- recent_changes = @data.select { |node| node[:mtime] }.sort_by { |node| node[:mtime].to_i }.reverse.first(5)
- vendor_counts = @data.group_by { |node| vendor_for_model(node[:model]) }.transform_values(&:count).sort_by { |vendor, count| [-count, vendor] }

.page-heading
  .page-heading-copy
    %span.eyebrow.text-muted Network overview
    %h1 Network operations
    %p Live inventory health, configuration history, and device actions.
  .page-heading-actions
    %label.visually-hidden{for: 'refreshInterval'} Automatic refresh interval
    %select.form-select.form-select-sm#refreshInterval{:'aria-label' => 'Automatic refresh interval'}
      %option{value: '0'} Auto refresh off
      %option{value: '30'} Every 30 seconds
      %option{value: '60'} Every minute
      %option{value: '300'} Every 5 minutes
    %button.btn.btn-outline-secondary{type: 'button', onclick: 'window.location.reload();'}
      %i.bi.bi-arrow-clockwise{:'aria-hidden' => 'true'}
      Refresh
    %button.btn.btn-outline-secondary#reload{type: 'button', disabled: !@management_error.nil?, title: @management_error}
      %i.bi.bi-arrow-repeat{:'aria-hidden' => 'true'}
      Reload source
    - if @management_error.nil?
      %a.btn.btn-primary.btn-add-device{href: url_for('/admin/devices')}
        %i.bi.bi-plus-lg{:'aria-hidden' => 'true'}
        Add Device
    - else
      %a.btn.btn-outline-secondary{href: url_for('/admin/devices'), title: @management_error}
        %i.bi.bi-shield-exclamation{:'aria-hidden' => 'true'}
        Admin actions unavailable

- if @management_error
  .alert.alert-warning.admin-availability{role: 'status', :'aria-live' => 'polite'}
    %i.bi.bi-shield-lock{:'aria-hidden' => 'true'}
    %span Administrative actions are disabled: #{@management_error} Open Device Management for setup details.

.alert.d-none#flashMessage{role: 'status', :'aria-live' => 'polite'}

.overview-grid{:'aria-label' => 'Latest backup summary'}
  .metric-card.metric-card-neutral
    .metric-topline
      %span.metric-icon
        %i.bi.bi-hdd-stack{:'aria-hidden' => 'true'}
      %span.metric-caption Total devices
    %strong.metric-value{:'data-counter' => total_nodes}= total_nodes
    %span.metric-note Devices in the current node list
  .metric-card.metric-card-success
    .metric-topline
      %span.metric-icon
        %i.bi.bi-check2-circle{:'aria-hidden' => 'true'}
      %span.metric-caption Latest backup successful
    %strong.metric-value{:'data-counter' => successful_nodes}= successful_nodes
    %span.metric-note Devices whose most recent run succeeded
  .metric-card.metric-card-danger
    .metric-topline
      %span.metric-icon
        %i.bi.bi-exclamation-circle{:'aria-hidden' => 'true'}
      %span.metric-caption Latest backup failed
    %strong.metric-value{:'data-counter' => failed_nodes}= failed_nodes
    %span.metric-note Devices whose most recent run failed
  .metric-card.metric-card-muted
    .metric-topline
      %span.metric-icon
        %i.bi.bi-clock-history{:'aria-hidden' => 'true'}
      %span.metric-caption No backup history
    %strong.metric-value{:'data-counter' => nodes_without_history}= nodes_without_history
    %span.metric-note Devices with no recorded latest run

.section-heading
  .section-heading-copy
    %h2 Managed devices
    %p Search, filter, inspect configuration history, or trigger a backup.

.dashboard-grid
  .chart-card.vendor-chart-card
    .chart-card-heading
      %span.chart-icon.chart-icon-cyan
        %i.bi.bi-pie-chart-fill{:'aria-hidden' => 'true'}
      .chart-heading-copy
        %h2 Vendor distribution
        %p Filter inventory by platform family
    - max_vendor_count = [vendor_counts.map(&:last).max.to_i, 1].max
    .vendor-chart-list
      - vendor_counts.each do |vendor, count|
        %button.vendor-chart-row{type: 'button', :'data-vendor-filter' => vendor, :'aria-label' => "Filter devices by #{vendor}, #{count} devices"}
          %span.vendor-mark{class: "vendor-#{vendor_logo(vendor)}", :'aria-hidden' => 'true'}
            - if vendor_logo_asset(vendor)
              %img.vendor-logo{src: url_for("/images/vendors/#{vendor_logo_asset(vendor)}.svg"), alt: '', loading: 'lazy'}
            - else
              %i.bi.bi-hdd-network
          %span.vendor-chart-label= vendor
          %span.vendor-bar-track
            %span.vendor-bar{style: "width: #{(count.to_f / max_vendor_count * 100).round}%"}
          %strong.vendor-chart-count= count
    - if vendor_counts.empty?
      .empty-state No vendor data is available in the current inventory.
  .chart-card.health-chart-card
    .chart-card-heading
      %span.chart-icon.chart-icon-green
        %i.bi.bi-heart-pulse-fill{:'aria-hidden' => 'true'}
      .chart-heading-copy
        %h2 Backup health
        %p Latest run status from Core
    .health-visual
      .health-ring{style: "--success-share: #{total_nodes.zero? ? 0 : (successful_nodes.to_f / total_nodes * 100).round}%", :'aria-label' => "#{successful_nodes} successful, #{failed_nodes} failed, #{nodes_without_history} never backed up"}
        .health-ring-inner
          %strong= total_nodes.zero? ? '—' : "#{(successful_nodes.to_f / total_nodes * 100).round}%"
          %span success
      .health-legend
        .health-legend-row
          %span.health-dot.health-dot-success
          %span Successful
          %strong= successful_nodes
        .health-legend-row
          %span.health-dot.health-dot-danger
          %span Failed
          %strong= failed_nodes
        .health-legend-row
          %span.health-dot.health-dot-muted
          %span Never backed up
          %strong= nodes_without_history

.table-card
  .table-toolbar
    .table-search
      %i.bi.bi-search{:'aria-hidden' => 'true'}
      %label.visually-hidden{for: 'inventorySearch'} Search device inventory
      %input#inventorySearch{type: 'search', placeholder: 'Search name, address, model, or group…'}
    %label.visually-hidden{for: 'vendorFilter'} Filter by vendor
    %select.form-select.form-select-sm.inventory-filter#vendorFilter{style: 'max-width: 170px'}
      %option{value: ''} All vendors
      - @data.map { |node| vendor_for_model(node[:model]) }.uniq.sort.each do |vendor|
        %option{value: vendor}= vendor
    %label.visually-hidden{for: 'modelFilter'} Filter by model
    %select.form-select.form-select-sm.inventory-filter#modelFilter{style: 'max-width: 170px'}
      %option{value: ''} All models
      - @data.map { |node| node[:model].to_s }.uniq.sort.each do |model|
        %option{value: model}= model
    %label.visually-hidden{for: 'statusFilter'} Filter by backup status
    %select.form-select.form-select-sm.inventory-filter#statusFilter{style: 'max-width: 170px'}
      %option{value: ''} All backup states
      - @data.map { |node| node[:status].to_s.tr('_', ' ') }.uniq.sort.each do |status|
        %option{value: status}= status
    %button.btn.btn-outline-secondary.btn-sm#resetSearch{type: 'button'}
      %i.bi.bi-eraser{:'aria-hidden' => 'true'}
      Clear search
  .table-responsive
    %table.table.table-hover.align-middle#nodesTable
      %thead
        %tr
          %th Device
          %th Address
          %th Vendor
          %th Platform / model
          %th.version-sort Software version
          %th Revision count
          %th Group
          %th Latest backup
          %th Last backup time
          %th Last changed
          %th Actions
      %tbody
        - @data.sort_by { |node| node[:name].to_s.downcase }.each do |node|
          %tr
            %td.device-cell
              %a.device-name{href: url_for("/node/show/#{node[:name]}")}= node[:name]
              %span.device-subtitle= node[:full_name] unless node[:full_name] == node[:name]
            %td.text-muted{:'data-order' => node[:ip]}= node[:ip]
            %td.vendor-cell
              %span.vendor-mark{class: "vendor-#{vendor_logo(node[:model])}", title: vendor_for_model(node[:model])}
                - if vendor_logo_asset(node[:model])
                  %img.vendor-logo{src: url_for("/images/vendors/#{vendor_logo_asset(node[:model])}.svg"), alt: '', loading: 'lazy'}
                - else
                  %i.bi.bi-hdd-network{:'aria-hidden' => 'true'}
              = vendor_for_model(node[:model])
            %td
              %a.model-link{href: url_for("/nodes/model/#{node[:model]}")}= node[:model]
            %td{:'data-order' => node.dig(:vars, 'version') || node[:version] || 'Unknown'}= node.dig(:vars, 'version') || node[:version] || 'Unknown'
            %td.text-end{:'data-order' => node[:revision_count].nil? ? -1 : node[:revision_count]}= node[:revision_count].nil? ? 'Unknown' : node[:revision_count]
            %td
              %a.group-link{href: url_for("/nodes/group/#{node[:group]}")}= node[:group]
            %td
              %span{title: node[:status].to_s.tr('_', ' '), class: node[:status].to_s}= node[:status].to_s.tr('_', ' ')
            %td.time.text-nowrap{epoch: node[:time] && node[:time] != 'never' ? node[:time].to_i : '', :'data-order' => node[:time] && node[:time] != 'never' ? node[:time].to_i : 0}= node[:time]
            %td.time.text-nowrap{epoch: node[:mtime] ? node[:mtime].to_i : '', :'data-order' => node[:mtime] ? node[:mtime].to_i : 0}= node[:mtime]
            %td.actions-cell
              %a.btn.btn-sm.btn-action.btn-action-view{href: url_for("/node/show/#{node[:full_name]}"), title: 'View details', :'aria-label' => "View details for #{node[:name]}", :'data-bs-toggle' => 'tooltip'}
                %i.bi.bi-eye{:'aria-hidden' => 'true'}
                %span Details
              %a.action-link{title: 'Download current configuration', :'aria-label' => "Download configuration for #{node[:name]}", href: url_for("/node/fetch/#{node[:full_name]}")}
                %i.bi.bi-cloud-download{:'aria-hidden' => 'true'}
              %a.action-link{title: 'View configuration history', :'aria-label' => "View configuration history for #{node[:name]}", href: url_for("/node/version?node_full=#{node[:full_name]}")}
                %i.bi.bi-clock-history{:'aria-hidden' => 'true'}
              - if @management_error.nil?
                %a.action-link{title: 'Edit device', :'aria-label' => "Edit #{node[:name]}", href: url_for("/admin/devices/#{node[:name]}/edit")}
                  %i.bi.bi-pencil-square{:'aria-hidden' => 'true'}
                %form.inline-action{action: url_for("/node/next/#{node[:full_name]}"), method: 'post'}
                  %button.action-link{title: 'Backup now', :'aria-label' => "Run configuration backup for #{node[:name]}", type: 'submit'}
                    %i.bi.bi-arrow-repeat{:'aria-hidden' => 'true'}
                %form.inline-action{action: url_for("/admin/devices/#{node[:name]}/delete"), method: 'post', onsubmit: "return confirm('Delete this device from the configured inventory? Git backup history will be retained.')"}
                  %button.action-link.action-delete{title: 'Delete device', :'aria-label' => "Delete #{node[:name]} from inventory", type: 'submit'}
                    %i.bi.bi-trash{:'aria-hidden' => 'true'}

:javascript
  $(function() {
    var refreshSelect = document.getElementById('refreshInterval');
    if (refreshSelect) {
      var savedInterval = localStorage.getItem('oxidized-dashboard-refresh') || '0';
      refreshSelect.value = savedInterval;
      refreshSelect.addEventListener('change', function() {
        localStorage.setItem('oxidized-dashboard-refresh', this.value);
        if (window.oxidizedRefreshTimer) window.clearInterval(window.oxidizedRefreshTimer);
        var seconds = Number(this.value);
        if (seconds > 0) window.oxidizedRefreshTimer = window.setInterval(function() { window.location.reload(); }, seconds * 1000);
      });
      var initialSeconds = Number(refreshSelect.value);
      if (initialSeconds > 0) window.oxidizedRefreshTimer = window.setInterval(function() { window.location.reload(); }, initialSeconds * 1000);
    }
    var table = $('#nodesTable').DataTable({
      columnDefs: [
        { targets: 1, type: 'ip-sort' },
        { targets: 4, type: 'version-sort' },
        { targets: [0, 10], className: 'noVis' },
      ],
      buttons: [{
        extend: 'colvis',
        columns: ':not(.noVis)',
        className: 'btn-primary',
        text: '<i class="bi bi-layout-three-columns" aria-hidden="true"></i> Columns'
      }],
      autoWidth: false,
      lengthMenu: [20, 50, 250, 500, { label: 'All', value: -1 }],
      stateSave: true,
      order: [[0, 'asc']]
    });

    table.buttons(0, 0).container().appendTo($('.table-toolbar'));
    table.buttons(0, 0).nodes().removeClass('btn-secondary');

    $('#inventorySearch').on('input', function() {
      table.search(this.value).draw();
    });
    $('#vendorFilter').on('change', function() { table.column(2).search(this.value, false, false).draw(); });
    $('#modelFilter').on('change', function() { table.column(3).search(this.value, false, false).draw(); });
    $('#statusFilter').on('change', function() { table.column(7).search(this.value, false, false).draw(); });
    $('[data-vendor-filter]').on('click', function() {
      $('#vendorFilter').val(this.dataset.vendorFilter).trigger('change');
      document.getElementById('nodesTable').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    $('#resetSearch').on('click', function() {
      $('#inventorySearch').val('');
      table.search('').draw();
      table.columns().search('').draw();
      $('.inventory-filter').val('');
    });
  });

.section-heading.recent-heading
  .section-heading-copy
    %h2 Recent configuration changes
    %p Most recently modified device configurations, based on the node modification timestamps.
.recent-changes-card
  - if recent_changes.empty?
    .empty-state No device modification timestamps are available.
  - else
    - recent_changes.each do |node|
      .recent-change-row
        .recent-change-icon
          %i.bi.bi-file-earmark-diff{:'aria-hidden' => 'true'}
        .recent-change-device
          %a.device-name{href: url_for("/node/show/#{node[:name]}")}= node[:name]
          %span.device-subtitle
            #{node[:model]} · #{node[:group]}
        %span.time.recent-change-time{epoch: node[:mtime].to_i}= node[:mtime]
        %a.action-link{title: 'View configuration history', :'aria-label' => "View configuration history for #{node[:name]}", href: url_for("/node/version?node_full=#{node[:full_name]}")}
          %i.bi.bi-arrow-up-right{:'aria-hidden' => 'true'}
