- health_nodes = @health_nodes || []
- successful_nodes = health_nodes.count { |node| node[:last_attempt_status].to_s == 'success' }
- failed_statuses = %w[no_connection no_auth auth_failure failure fail error timeout timelimit].freeze
- failed_nodes = health_nodes.count { |node| failed_statuses.include?(node[:last_attempt_status].to_s) }
- running_nodes = health_nodes.count { |node| node[:backup_state].to_s == 'running' }
- queued_nodes = health_nodes.count { |node| node[:backup_state].to_s == 'queued' }
- no_revision_nodes = health_nodes.count { |node| node[:revision_count] == 0 }

.page-heading
  .page-heading-copy
    .breadcrumbs
      %a{href: url_for('/nodes')} Network overview
      %i.bi.bi-chevron-right{:'aria-hidden' => 'true'}
      %span Backup health
    %span.eyebrow.text-muted Operations
    %h1 Backup health
    %p Current Core attempts and stored configuration history. Attempt state resets when Core restarts.
  .page-heading-actions
    %button.btn.btn-outline-secondary{type: 'button', onclick: 'window.location.reload();'}
      %i.bi.bi-arrow-clockwise{:'aria-hidden' => 'true'}
      Refresh
    - if @current_admin == :admin
      != haml :backup_all, layout: false

.overview-grid.health-overview-grid{:'aria-label' => 'Backup health summary'}
  .metric-card.metric-card-neutral
    .metric-topline
      %span.metric-icon
        %i.bi.bi-hdd-stack{:'aria-hidden' => 'true'}
      %span.metric-caption Total devices
    %strong.metric-value= health_nodes.length
    %span.metric-note Loaded from the current Oxidized inventory
  .metric-card.metric-card-success
    .metric-topline
      %span.metric-icon
        %i.bi.bi-check2-circle{:'aria-hidden' => 'true'}
      %span.metric-caption Successful
    %strong.metric-value= successful_nodes
    %span.metric-note Latest known attempt
  .metric-card.metric-card-danger
    .metric-topline
      %span.metric-icon
        %i.bi.bi-exclamation-circle{:'aria-hidden' => 'true'}
      %span.metric-caption Failed
    %strong.metric-value= failed_nodes
    %span.metric-note Latest known attempt
  .metric-card.metric-card-warning
    .metric-topline
      %span.metric-icon
        %i.bi.bi-hourglass-split{:'aria-hidden' => 'true'}
      %span.metric-caption Running / queued
    %strong.metric-value= running_nodes + queued_nodes
    %span.metric-note #{running_nodes} running · #{queued_nodes} queued
  .metric-card.metric-card-muted
    .metric-topline
      %span.metric-icon
        %i.bi.bi-archive{:'aria-hidden' => 'true'}
      %span.metric-caption No saved configuration
    %strong.metric-value= no_revision_nodes
    %span.metric-note Devices with no known Git revisions

.table-card.stats-card
  .table-toolbar
    .table-search
      %i.bi.bi-search{:'aria-hidden' => 'true'}
      %label.visually-hidden{for: 'statsSearch'} Search backup health
      %input#statsSearch{type: 'search', placeholder: 'Search device, address, or model…'}
    %label.visually-hidden{for: 'statsStatusFilter'} Filter backup status
    %select.form-select.form-select-sm#statsStatusFilter{style: 'max-width: 200px'}
      %option{value: ''} All statuses
      - health_nodes.map { |node| node[:backup_state].to_s.tr('_', ' ') }.uniq.sort.each do |state|
        %option{value: state}= state
    %label.visually-hidden{for: 'statsVendorFilter'} Filter vendor
    %select.form-select.form-select-sm#statsVendorFilter{style: 'max-width: 180px'}
      %option{value: ''} All vendors
      - health_nodes.map { |node| vendor_for_model(node[:model]) }.uniq.sort.each do |vendor|
        %option{value: vendor}= vendor
    %button.btn.btn-outline-danger.btn-sm#filterFailed{type: 'button'} Failed
    %button.btn.btn-outline-secondary.btn-sm#filterNotChecked{type: 'button'} Not checked
    %button.btn.btn-outline-secondary.btn-sm#resetSearch{type: 'button'}
      %i.bi.bi-eraser{:'aria-hidden' => 'true'}
      Clear filters
  .table-responsive
    %table.table.table-hover.align-middle#statsTable
      %thead
        %tr
          %th Device
          %th Management IP
          %th Last attempt
          %th Last success
          %th Status
          %th Failure reason
          %th Actions
      %tbody
        - health_nodes.sort_by { |node| node[:name].to_s.downcase }.each do |node|
          - stats = @data[node[:name]]
          - successes = stats && stats.get(:success)
          - last_success = successes && successes.last && successes.last[:end]
          - status = node[:backup_state].to_s
          - failure_reason = { 'no_connection' => 'Connection failed', 'no_auth' => 'Authentication failed', 'auth_failure' => 'Authentication failed', 'timelimit' => 'Collection timed out', 'fail' => 'Core reported failure', 'failure' => 'Core reported failure' }[node[:last_attempt_status].to_s]
          %tr
            %td.device-cell
              %a.device-name{href: url_for("/node/show/#{node[:full_name]}")}= node[:name]
              %span.device-subtitle= "#{vendor_for_model(node[:model])} · #{node[:model]}"
            %td= node[:ip] || 'Unknown'
            %td.time.text-nowrap{epoch: timestamp_time(node[:last_attempt_at])&.to_i}= timestamp_time(node[:last_attempt_at]) || 'Not checked this session'
            %td.time.text-nowrap{epoch: timestamp_time(last_success)&.to_i}= timestamp_time(last_success) || 'Unknown'
            %td
              %span.status-pill{class: "status-#{status}"}= status.tr('_', ' ')
            %td= failure_reason || (failed_statuses.include?(node[:last_attempt_status].to_s) ? 'See Oxidized logs for details' : '—')
            %td.actions-cell
              %a.btn.btn-sm.btn-outline-secondary{href: url_for("/node/show/#{node[:full_name]}")}
                %i.bi.bi-eye{:'aria-hidden' => 'true'}
                Details
              - if @current_admin == :admin
                %form.inline-action{action: url_for("/node/next/#{node[:full_name]}"), method: 'post'}
                  %input{type: 'hidden', name: 'csrf_token', value: @csrf_token}
                  %button.action-link{type: 'submit', :'aria-label' => "Retry backup for #{node[:name]}"}
                    %i.bi.bi-arrow-repeat{:'aria-hidden' => 'true'}
                    Retry backup
        - if health_nodes.empty?
          %tr
            %td.empty-state{colspan: 7} No devices are available in the current inventory.

:javascript
  $(function() {
    var table = $('#statsTable').DataTable({
      autoWidth: false,
      order: [[0, 'asc']],
      lengthMenu: [20, 50, 250, 500, { label: 'All', value: -1 }],
      dom: 'lrtip',
      searching: true,
      stateSave: true
    });
    $('#statsSearch').on('input', function() { table.search(this.value).draw(); });
    $('#statsStatusFilter').on('change', function() { table.column(4).search(this.value, false, false).draw(); });
    $('#statsVendorFilter').on('change', function() { table.column(0).search(this.value, false, false).draw(); });
    $('#filterFailed').on('click', function() {
      $('#statsStatusFilter').val('');
      table.column(4).search('no connection|no auth|auth failure|failure|fail|timelimit|error|timeout', true, false).draw();
    });
    $('#filterNotChecked').on('click', function() {
      $('#statsStatusFilter').val('');
      table.column(4).search('not checked|never backed up', true, false).draw();
    });
    $('#resetSearch').on('click', function() {
      $('#statsSearch').val('');
      $('#statsStatusFilter, #statsVendorFilter').val('');
      table.search('');
      table.columns().every(function() { this.search(''); });
      table.draw();
    });
  });
