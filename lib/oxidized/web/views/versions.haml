.page-heading
  .page-heading-copy
    .breadcrumbs
      %a{href: url_for('/nodes')} Devices
      %i.bi.bi-chevron-right{:'aria-hidden' => 'true'}
      %span Configuration history
    %span.eyebrow.text-muted Version control
    %h1 Configuration history
    %p
      Versions for
      %strong= @node
      - if @group
        %span.text-muted in #{@group}
  .page-heading-actions
    %a.btn.btn-outline-secondary{href: url_for('/nodes')}
      %i.bi.bi-arrow-left{:'aria-hidden' => 'true'}
      Device inventory

.history-summary
  .history-summary-icon
    %i.bi.bi-clock-history{:'aria-hidden' => 'true'}
  .history-summary-copy
    %strong= @data.count
    %span saved configuration versions

.table-card.history-card
  .table-toolbar
    .table-search
      %i.bi.bi-search{:'aria-hidden' => 'true'}
      %label.visually-hidden{for: 'historySearch'} Search backup history
      %input#historySearch{type: 'search', placeholder: 'Search revisions…'}
    %span.toolbar-label Available versions
  .table-responsive
    %table.table.table-hover.align-middle#versionsTable
      %thead
        %tr
          %th Version
          %th Saved at
          %th Age
          %th Author
          %th Actions
      %tbody
        - nb = @data.count + 1
        - @data.each do |x|
          - version_num = nb -= 1
          - revision_author = x[:author] || x['author']
          - author_name = revision_author.is_a?(Hash) ? (revision_author[:name] || revision_author['name']) : revision_author
          - author_email = revision_author.is_a?(Hash) ? (revision_author[:email] || revision_author['email']) : nil
          %tr
            %td{:'data-order' => version_num}
              .version-number
                %span.version-chip v#{version_num}
                - if version_num == @data.count
                  %span.latest-chip Latest
            %td.time{epoch: x[:time].to_i, :'data-order' => x[:time].to_i}= x[:time]
            %td{:'data-order' => x[:time].to_i}= time_from_now x[:time]
            %td.author-cell{:'data-order' => author_name.to_s.downcase, title: author_email}= author_name.to_s.empty? ? 'Unknown' : author_name
            %td.actions-cell
              - query = Rack::Utils.build_query(node: @node, group: @group, oid: x[:oid], epoch: x[:time].to_i, num: version_num)
              %a.action-link{title: 'Download configuration version', :'aria-label' => "Download version #{version_num} for #{@node}", href: url_for("/node/version/view?#{query}")}
                %i.bi.bi-cloud-download{:'aria-hidden' => 'true'}
              - if version_num > 1
                %a.action-link{title: 'Compare with previous version', :'aria-label' => "Compare version #{version_num} for #{@node} with the previous version", href: url_for("/node/version/diffs?#{query}")}
                  %i.bi.bi-file-earmark-diff{:'aria-hidden' => 'true'}

:javascript
  $(function() {
    $('#versionsTable').DataTable({
      order: [[0, 'desc']],
      autoWidth: false,
      columnDefs: [{ targets: '_all', className: 'text-start' }],
      stateSave: true,
      searching: true,
      lengthChange: true,
      lengthMenu: [10, 25, 50, { label: 'All', value: -1 }],
      stateLoadParams: function(_settings, state) { state.order = [[0, 'desc']]; }
    });
    $('#historySearch').on('input', function() { $('#versionsTable').DataTable().search(this.value).draw(); });
  });
